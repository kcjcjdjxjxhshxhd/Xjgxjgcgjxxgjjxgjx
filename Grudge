--// ROOM TRACKER (ENTITY ENTER CURRENT PLAYER ROOM)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local currentRoom = nil
local lastRoomName = nil

--// detect room localplayer Ä‘ang Ä‘á»©ng
local function getPlayerRoom()
	local char = player.Character
	if not char then return nil end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local roomsFolder = workspace:FindFirstChild("CurrentRooms")
	if not roomsFolder then return nil end

	for _, room in ipairs(roomsFolder:GetChildren()) do
		if room:IsA("Model") then
			-- check simple bounding box
			local cf, size = room:GetBoundingBox()
			local pos = hrp.Position

			local relative = cf:PointToObjectSpace(pos)
			if math.abs(relative.X) < size.X/2
			and math.abs(relative.Y) < size.Y/2
			and math.abs(relative.Z) < size.Z/2 then
				return room
			end
		end
	end

	return nil
end

--// detect entity model
local function getEntity()
	return workspace:FindFirstChild("Grudge_A21")
end

--// loop check
task.spawn(function()
	while task.wait(0.2) do
		local room = getPlayerRoom()
		local entity = getEntity()

		if room and entity then
			-- chá»‰ trigger khi room Ä‘á»•i (trĂ¡nh spam sound)
			if room.Name ~= lastRoomName then
				lastRoomName = room.Name
			end

			-- check entity cĂ³ náº±m trong cĂ¹ng room ko
			local cf, size = room:GetBoundingBox()
			local pos = entity:GetPivot().Position

			local relative = cf:PointToObjectSpace(pos)

			local insideRoom =
				math.abs(relative.X) < size.X/2 and
				math.abs(relative.Y) < size.Y/2 and
				math.abs(relative.Z) < size.Z/2

			if insideRoom then
				if not sound2.IsPlaying then
					sound2:Play()
				end
			end
		end
	end
end)
