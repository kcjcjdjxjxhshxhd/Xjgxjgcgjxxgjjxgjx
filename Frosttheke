-- QUáº¢N LĂ PHĂ’NG (HĂ€M Gá»C Tá»I Æ¯U)


local function onRoomAdded(room)
	task.wait(0.5)


	-- Tá»‘i Æ°u FPS: Cháº¡y xá»­ lĂ½ Ä‘Ă¨n vĂ  cá»­a sá»• song song khĂ´ng gĂ¢y ngháº½n luá»“ng chĂ­nh
	task.defer(function()
		-- 1. Äá»•i mĂ u Ä‘Ă¨n phĂ²ng
		setupFrozenLights(room)


		-- 2. QuĂ©t tĂ¬m vĂ  xá»­ lĂ½ táº¥t cáº£ Cá»­a Sá»• CHá»ˆ TRONG PHĂ’NG NĂ€Y (PhĂ²ng nĂ o khĂ´ng cĂ³ tá»± Ä‘á»™ng bá» qua)
		for _, obj in ipairs(room:GetDescendants()) do
			if obj:IsA("Model") and obj.Name == "Window" then
				setupWindow(obj)
			end
		end
	end)


	-- 3. Tá»ˆ Lá»† 1/3: Quyáº¿t Ä‘á»‹nh spawn mĂ´ hĂ¬nh bÄƒng dÆ°á»›i sĂ n
	if math.random(1, 3) ~= 1 then return end


	local floors = {}
	local mainFloor = room:FindFirstChild("Floor") or room:FindFirstChild("Base")


	if mainFloor and mainFloor:IsA("BasePart") and mainFloor.Size.X > 4 and mainFloor.Size.Z > 4 then
		table.insert(floors, mainFloor)
	end


	for _, obj in ipairs(room:GetDescendants()) do
		if obj:IsA("BasePart") and (obj.Name == "Floor" or obj.Name == "Base" or obj.Name == "Carpet" or obj.Name == "Path") then
			if obj.Size.X > 4 and obj.Size.Z > 4 and not table.find(floors, obj) then
				table.insert(floors, obj)
			end
		end
	end


	if #floors == 0 then return end


	local totalModelsToSpawn = math.random(1, 2)
	
	if totalModelsToSpawn == 1 then
		local targetFloor = floors[math.random(1, #floors)]
		spawnModelsOnSpecificFloor(targetFloor, 1)
	else
		local targetFloor1 = floors[math.random(1, #floors)]
		local targetFloor2 = floors[math.random(1, #floors)]
		
		if targetFloor1 == targetFloor2 then
			spawnModelsOnSpecificFloor(targetFloor1, 2)
		else
			spawnModelsOnSpecificFloor(targetFloor1, 1)
			spawnModelsOnSpecificFloor(targetFloor2, 1)
		end
	end
end


-- KĂ­ch hoáº¡t há»‡ thá»‘ng láº¯ng nghe phĂ²ng
for _, room in pairs(currentRooms:GetChildren()) do
