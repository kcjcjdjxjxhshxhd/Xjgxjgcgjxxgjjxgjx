local MODEL_IDS = {
    "rbxassetid://123394042081913", 
    "rbxassetid://75597378264678"
}


local function loadModelFromId(assetPath)
    local success, result = pcall(function()
        return game:GetObjects(assetPath)
    end)
    if success and result and #result > 0 then
        local original = result[1]
        local clone = original:Clone()
        original:Destroy()
        return clone
    end
    return nil
end


local function getRandomPosOnFloor(floor, modelHeight)
    local floorSize = floor.Size
    local limitX = floorSize.X / 2 - 4
    local limitZ = floorSize.Z / 2 - 4
    local randomX = (limitX <= 0) and math.random(-floorSize.X / 2, floorSize.X / 2) or math.random(-limitX, limitX)
    local randomZ = (limitZ <= 0) and math.random(-floorSize.Z / 2, floorSize.Z / 2) or math.random(-limitZ, limitZ)
    return Vector3.new(randomX, (floorSize.Y / 2) + (modelHeight / 2), randomZ)
end


local function spawnModelsOnSpecificFloor(floor, count)
    local spawnedPositions = {}


    for i = 1, count do
        local randomPath = MODEL_IDS[math.random(1, #MODEL_IDS)]
        local newModel = loadModelFromId(randomPath)
        
        if not newModel then continue end
        
        newModel.Name = "ICE_MODEL_" .. i
        
        for _, part in pairs(newModel:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false 
                part.CanQuery = false   
                part.CanTouch = false   
            end
        end
        
        local size = newModel:GetExtentsSize()
        local localPos
        
        if i == 1 then
            localPos = getRandomPosOnFloor(floor, size.Y)
        else
            local attempts = 0
            while true do
                attempts = attempts + 1
                local tempPos = getRandomPosOnFloor(floor, size.Y)
                if (tempPos - spawnedPositions[1]).Magnitude >= 20 or attempts > 30 then
                    localPos = tempPos
                    break
                end
            end
        end
        
        table.insert(spawnedPositions, localPos)
        newModel.Parent = floor
        
        local randomRotationY = math.rad(math.random(0, 360))
        local targetCFrame = floor.CFrame * CFrame.new(localPos) * CFrame.Angles(0, randomRotationY, 0)
        newModel:PivotTo(targetCFrame)
    end
end


