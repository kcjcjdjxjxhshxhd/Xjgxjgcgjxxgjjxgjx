local function setupFrozenLights(room)
	for _, descendant in ipairs(room:GetDescendants()) do
		local isLightFolder = descendant:IsA("Folder") and descendant.Name == "Light_Fixtures"
		local isChandelier = descendant:IsA("Model") and descendant.Name == "Chandelier"


		if isLightFolder or isChandelier then
			local fixtureModels = isLightFolder and descendant:GetChildren() or {descendant}


			for _, fixtureModel in ipairs(fixtureModels) do
				local lightFixture = fixtureModel:FindFirstChild("LightFixture") or fixtureModel:FindFirstChildWhichIsA("BasePart")


				if lightFixture and lightFixture:IsA("BasePart") then
					if not lightFixture:FindFirstChild("FrozenSmoke") then
						local smoke = Instance.new("Smoke")
						smoke.Name = "FrozenSmoke"
						smoke.Color = FROZEN_COLOR
						smoke.Opacity = 0.1
						smoke.Size = 0.5
						smoke.Parent = lightFixture
					end
				end


				for _, obj in ipairs(fixtureModel:GetDescendants()) do
					if obj:IsA("BasePart") and (obj.Name == "Neon" or obj.Material == Enum.Material.Neon) then
						obj.Color = FROZEN_COLOR
					end
					if obj:IsA("Light") then
						obj.Color = FROZEN_COLOR
					end
				end
			end
		end
	end
end


