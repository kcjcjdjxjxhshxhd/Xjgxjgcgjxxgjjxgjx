-- HĂ m táº¡o ParticleEmitter mÆ°a hiá»‡u nÄƒng cao
local function createRainEmitter()
	local rain = Instance.new("ParticleEmitter")
	rain.Texture = "rbxassetid://86574624318804"
	rain.Rate = 25 -- Giáº£m nháº¹ tá»« 30 xuá»‘ng 25 Ä‘á»ƒ tá»‘i Æ°u FPS khi cĂ³ nhiá»u cá»­a sá»•
	rain.Lifetime = NumberRange.new(0.7, 1)
	rain.Speed = NumberRange.new(3, 4)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.SpreadAngle = Vector2.new(5, 5)
	rain.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 5),
		NumberSequenceKeypoint.new(1, 4)
	})
	rain.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1)
	})
	rain.Acceleration = Vector3.new(0, -15, 0)
	return rain
end


local function setupWindow(model)
	if not (model:IsA("Model") and model.Name == "Window") then return end


	-- 1. ÄĂƒ XĂ“A TOĂ€N Bá»˜ PHáº¦N Táº O VĂ€ Xá»¬ LĂ Ă‚M THANH KHá»I SCRIPT


	-- 2. Xá»­ lĂ½ Part 'Particles' vĂ  gáº¯n hiá»‡u á»©ng mÆ°a
	local particlesPart = model:FindFirstChild("Particles")
	if particlesPart and particlesPart:IsA("BasePart") then
		for _, child in ipairs(particlesPart:GetChildren()) do
			if child:IsA("ParticleEmitter") then
				child:Destroy()
			end
		end


		local newRain = createRainEmitter()
		newRain.Parent = particlesPart
	end


	-- Xá»­ lĂ½ Ä‘á»•i mĂ u cĂ¡c bá»™ pháº­n cá»§a Cá»­a sá»• (Skybox & SurfaceLight)
	for _, desc in ipairs(model:GetDescendants()) do
		-- Äá»•i mĂ u Mesh/Part tĂªn 'Skybox'
		if desc.Name == "Skybox" then
			if desc:IsA("SpecialMesh") or desc:IsA("FileMesh") then
				desc.VertexColor = Vector3.new(24/255, 56/255, 69/255)
			elseif desc:IsA("BlockMesh") then
				-- Bá» qua VertexColor cá»§a BlockMesh Ä‘á»ƒ trĂ¡nh lá»—i
			elseif desc:IsA("BasePart") then
				desc.Color = Color3.fromRGB(24, 56, 69)
			end
			
			if desc.Parent and desc.Parent:IsA("BasePart") then
				desc.Parent.Color = Color3.fromRGB(24, 56, 69)
			end
		-- Äá»•i mĂ u SurfaceLight
		elseif desc:IsA("SurfaceLight") and desc.Name == "SurfaceLight" then
			desc.Color = Color3.fromRGB(0, 76, 90)
		end
	end
end


