task.spawn(function()

	local duration = 4
	local start = tick()

	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = tick() - start
		local progress = elapsed / duration

		if progress >= 1 then
			connection:Disconnect()
			return
		end

		--// intensity giáº£m dáº§n
		local intensity = (1 - progress)^0.7

		--// wave offset máº¡nh
		local offsetX = math.sin(tick() * 42) * 1.8 * intensity
		local offsetY = math.cos(tick() * 33) * 1.4 * intensity
		local offsetZ = math.sin(tick() * 25) * 0.9 * intensity

		--// nghiĂªng camera kiá»ƒu sĂ³ng
		local tiltX = math.rad(math.sin(tick() * 20) * 8 * intensity)
		local tiltY = math.rad(math.cos(tick() * 17) * 8 * intensity)
		local tiltZ = math.rad(math.sin(tick() * 28) * 14 * intensity)

		camera.CFrame =
			camera.CFrame
			* CFrame.new(
				offsetX * 0.12,
				offsetY * 0.12,
				offsetZ * 0.06
			)
			* CFrame.Angles(
				tiltX,
				tiltY,
				tiltZ
			)
	end)

end)
