--// COPY ID
local function setupCopyButton(button, id)

	button.MouseButton1Click:Connect(function()

		local extracted = tostring(id):match("%d+")

		if extracted then

			pcall(function()
				if setclipboard then
					setclipboard(extracted)
				elseif toclipboard then
					toclipboard(extracted)
				end
			end)

			button.Text = "Copied ID"

			task.delay(2, function()
				if button and button.Parent then
					button.Text = "Copy ID"
				end
			end)
		end
	end)
end

