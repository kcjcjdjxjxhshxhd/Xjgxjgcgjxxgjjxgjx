local function switchTab(tab)

	currentTab = tab

	soundsTab.BackgroundColor3 = Color3.fromRGB(45,45,45)
	animTab.BackgroundColor3 = Color3.fromRGB(45,45,45)
	modelsTab.BackgroundColor3 = Color3.fromRGB(45,45,45)

	if tab == "Sounds" then
		soundsTab.BackgroundColor3 = Color3.fromRGB(0,170,255)

	elseif tab == "Animations" then
		animTab.BackgroundColor3 = Color3.fromRGB(0,170,255)

	elseif tab == "Models" then
		modelsTab.BackgroundColor3 = Color3.fromRGB(0,170,255)
	end

	updateSearch()
end

