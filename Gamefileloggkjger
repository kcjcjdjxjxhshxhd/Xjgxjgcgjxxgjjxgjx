--// ADD SOUND
local function addSound(sound)

	if soundData[sound] then
		return
	end

	local frame, copyButton, playButton = createItem(sound.Name)

	setupCopyButton(copyButton, sound.SoundId)

	playButton.MouseButton1Click:Connect(function()

		if currentPlayingSound == sound then
			stopCurrentSound()
			return
		end

		stopCurrentSound()

		pcall(function()
			sound:Play()
		end)

		currentPlayingSound = sound
		currentPlayingButton = playButton

		playButton.Text = "Stop"
		playButton.BackgroundColor3 = Color3.fromRGB(255,70,70)

		soloSound(sound)

		task.spawn(function()

			repeat
				task.wait(0.2)
			until
				not sound.Parent
				or not sound.Playing
				or currentPlayingSound ~= sound

			if currentPlayingSound == sound then
				stopCurrentSound()
			end
		end)
	end)

	soundData[sound] = {
		Frame = frame,
		LowerName = string.lower(sound.Name)
	}

	updateSearch()
end

--// ADD ANIMATION
local function addAnimation(anim)

	if animationData[anim] then
		return
	end

	local frame, copyButton, playButton = createItem(anim.Name)

	setupCopyButton(copyButton, anim.AnimationId)

	playButton.MouseButton1Click:Connect(function()

		--// stop náº¿u Ä‘ang play chĂ­nh animation nĂ y
		if currentAnimationTrack and currentAnimationTrack.Animation.AnimationId == anim.AnimationId then
			stopCurrentAnimation()
			return
		end

		--// stop animation cÅ©
		stopCurrentAnimation()

		local character = LocalPlayer.Character
		if not character then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		local animator = humanoid:FindFirstChildOfClass("Animator")

		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end

		local animation = Instance.new("Animation")
		animation.AnimationId = anim.AnimationId

		local track

		pcall(function()
			track = animator:LoadAnimation(animation)
		end)

		if not track then
			return
		end

		--// priority cao Ä‘á»ƒ ko bá»‹ override
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false

		currentAnimationTrack = track
		currentAnimationButton = playButton

		playButton.Text = "Stop"
		playButton.BackgroundColor3 = Color3.fromRGB(255,70,70)

		track:Play(0.1, 1, 1)

		--// auto reset button khi animation end
		track.Stopped:Connect(function()

			if currentAnimationTrack == track then
				stopCurrentAnimation()
			end
		end)
	end)

	animationData[anim] = {
		Frame = frame,
		LowerName = string.lower(anim.Name)
	}

	updateSearch()
end

--// ADD MODEL
local function addModel(model)

	if modelData[model] then
		return
	end

	if Players:GetPlayerFromCharacter(model) then
		return
	end

	local frame, copyButton, spawnButton = createItem(model.Name)

	copyButton.Visible = false

	spawnButton.Text = "Spawn"

	local spawnedClones = {}

	spawnButton.MouseButton1Click:Connect(function()

		--// remove táº¥t cáº£ clones
		if #spawnedClones > 0 then

			for _, clone in ipairs(spawnedClones) do
				if clone and clone.Parent then
					clone:Destroy()
				end
			end

			table.clear(spawnedClones)

			spawnButton.Text = "Spawn"
			spawnButton.BackgroundColor3 = Color3.fromRGB(0,170,255)

			return
		end

		local char = LocalPlayer.Character
		if not char then
			return
		end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local clone

		pcall(function()
			clone = model:Clone()
		end)

		if not clone then
			return
		end

		clone.Parent = workspace

		for _, obj in ipairs(clone:GetDescendants()) do

			if obj:IsA("Animator")
			or obj:IsA("AnimationController")
			or obj:IsA("Animation") then

				obj:Destroy()
			end

			if obj:IsA("BasePart") then
				obj.Anchored = true
			end
		end

		local offset = (#spawnedClones * 6)

		local pos =
			hrp.Position
			+ (hrp.CFrame.LookVector * 10)
			+ Vector3.new(offset,0,0)

		pcall(function()
			clone:PivotTo(CFrame.new(pos))
		end)

		table.insert(spawnedClones, clone)

		spawnButton.Text = "Remove"
		spawnButton.BackgroundColor3 = Color3.fromRGB(255,70,70)
	end)

	modelData[model] = {
		Frame = frame,
		LowerName = string.lower(model.Name)
	}

	updateSearch()
end

--// REMOVE
local function removeObject(obj)

	if soundData[obj] then
		soundData[obj].Frame:Destroy()
		soundData[obj] = nil
	end

	if animationData[obj] then
		animationData[obj].Frame:Destroy()
		animationData[obj] = nil
	end

	if modelData[obj] then

		if spawnedModels[obj] then
			spawnedModels[obj]:Destroy()
			spawnedModels[obj] = nil
		end

		modelData[obj].Frame:Destroy()
		modelData[obj] = nil
	end

	updateCanvas()
end

