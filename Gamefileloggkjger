--// RESTORE SOUND VOLUME
local function restoreVolumes()
	for sound, volume in pairs(mutedSounds) do
		if sound and sound.Parent then
			pcall(function()
				sound.Volume = volume
			end)
		end
	end

	table.clear(mutedSounds)
end

--// SOLO SOUND
local function soloSound(target)
	restoreVolumes()

	for _, obj in ipairs(game:GetDescendants()) do
		if obj:IsA("Sound") and obj ~= target and obj.Playing then
			mutedSounds[obj] = obj.Volume

			pcall(function()
				obj.Volume = 0
			end)
		end
	end
end

--// STOP CURRENT SOUND
local function stopCurrentSound()
	if currentPlayingSound then
		pcall(function()
			currentPlayingSound:Stop()
		end)
	end

	restoreVolumes()

	if currentPlayingButton then
		currentPlayingButton.Text = "Play"
		currentPlayingButton.BackgroundColor3 = Color3.fromRGB(0,170,255)
	end

	currentPlayingSound = nil
	currentPlayingButton = nil
end

--// STOP CURRENT ANIMATION
local function stopCurrentAnimation()

	if currentAnimationTrack then

		pcall(function()
			currentAnimationTrack:Stop(0.1)
		end)

		task.wait(0.1)

		pcall(function()
			currentAnimationTrack:Destroy()
		end)
	end

	if currentAnimationButton then
		currentAnimationButton.Text = "Play"
		currentAnimationButton.BackgroundColor3 = Color3.fromRGB(0,170,255)
	end

	currentAnimationTrack = nil
	currentAnimationButton = nil
end

--// SEARCH
local function updateSearch()

	local txt = string.lower(search.Text)

	for _, data in pairs(soundData) do
		data.Frame.Visible =
			currentTab == "Sounds"
			and (txt == "" or string.find(data.LowerName, txt, 1, true))
	end

	for _, data in pairs(animationData) do
		data.Frame.Visible =
			currentTab == "Animations"
			and (txt == "" or string.find(data.LowerName, txt, 1, true))
	end

	for _, data in pairs(modelData) do
		data.Frame.Visible =
			currentTab == "Models"
			and (txt == "" or string.find(data.LowerName, txt, 1, true))
	end

	updateCanvas()
end

search:GetPropertyChangedSignal("Text"):Connect(updateSearch)

